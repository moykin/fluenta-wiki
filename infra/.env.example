# Шаблон переменных окружения. Реальные значения — только в .env (в .gitignore)
# и в env_file на сервере. Никогда не коммитить заполненный файл.

# ─── База данных ───
POSTGRES_DB=fluenta
POSTGRES_USER=fluenta
POSTGRES_PASSWORD=<сгенерировать: openssl rand -base64 32>
DATABASE_URL=postgresql+asyncpg://fluenta:<пароль>@postgres:5432/fluenta

# ─── Аутентификация ───
JWT_SECRET=<сгенерировать: openssl rand -hex 32>
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ─── LLM и голос (ключи живут ТОЛЬКО на сервере, клиенту не отдаются) ───
GEMINI_API_KEY=<ключ Gemini>
GEMINI_LIVE_MODEL=<id модели для голоса реального времени>

# ─── Приложение ───
APP_ENV=production
PUBLIC_BASE_URL=https://fluenta.wiki
CORS_ORIGINS=https://fluenta.wiki

# ─── Caddy / TLS ───
DOMAIN=fluenta.wiki
ACME_EMAIL=<email для Let's Encrypt>

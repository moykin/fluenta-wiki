# Шаблон серверного окружения. Реальный файл — /opt/fluenta/.env на сервере,
# права 600, владелец — пользователь деплоя. В репозиторий не попадает никогда.
#
# Сгенерировать сильное значение:  openssl rand -base64 32

# ─────────────────────── Прод: база данных ───────────────────────
POSTGRES_DB=fluenta
POSTGRES_USER=fluenta
POSTGRES_PASSWORD=<сгенерировать>

# ──────────────────────── Dev: база данных ────────────────────────
DEV_DB=fluenta_dev
DEV_DB_USER=fluenta_dev
DEV_DB_PASSWORD=<сгенерировать, ДРУГОЕ значение>

# ───────────────────────── Прод: приложение ─────────────────────────
JWT_SECRET=<сгенерировать: openssl rand -hex 32>
GEMINI_API_KEY=<боевой ключ Gemini>
PROD_CORS_ORIGINS=https://fluenta.wiki,https://www.fluenta.wiki,https://app.fluenta.wiki
PROD_TAG=latest

# ────────────────────────── Dev: приложение ──────────────────────────
DEV_JWT_SECRET=<сгенерировать, ДРУГОЕ значение>
# Отдельный ключ Gemini с меньшей квотой: эксперименты на dev не должны
# выжигать боевой лимит и бюджет.
DEV_GEMINI_API_KEY=<dev-ключ Gemini>
DEV_CORS_ORIGINS=https://dev.fluenta.wiki,https://app-dev.fluenta.wiki
DEV_TAG=main

# ──────────────────────── Доступ к dev-стенду ────────────────────────
# Хэш пароля для basic auth. Сгенерировать:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<пароль>'
DEV_BASICAUTH_HASH=<хэш>
